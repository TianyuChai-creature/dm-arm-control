8','libyaml-cpp-dev','libusb-1.0-0','libstdc++6','libc6'],text=True).splitlines(),\n 'python_dependencies':sorted(f'{d.metadata[\"Name\"]}=={d.version}' for d in importlib.metadata.distributions())\n}\nPath('/work/build-info.json').write_text(json.dumps(info,indent=2)+'\\n')\nPY\n",
